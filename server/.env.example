# Copy to .env and fill in
PORT=3005
MONGODB_URI=mongodb://localhost:27017/pet-adoption
# any long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me
# comma separated list of client addresses allowed to call the API
CLIENT_ORIGINS=http://localhost:3000,https://wepets.onrender.com
